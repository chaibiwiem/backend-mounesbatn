NODE_ENV=development
PORT=5000

# Base de donnees
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=farahbooking
# Alternative : une seule variable DATABASE_URL (prioritaire si definie)
# DATABASE_URL=mysql://user:password@localhost:3306/farahbooking

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_me_too_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Emails (Nodemailer) - SMTP plateforme, utilise par defaut si un
# prestataire n'a pas configure son propre SMTP/Resend (voir ENCRYPTION_KEY).
SMTP_HOST=smtp.votre-fournisseur.com
SMTP_PORT=587
SMTP_USER=contact@mounesba.tn
SMTP_PASS=

# Chiffrement au repos des identifiants SMTP/Resend saisis par un prestataire
# (listings.email_settings). 32 octets aleatoires, ex: openssl rand -hex 32.
ENCRYPTION_KEY=change_me_to_a_random_32_byte_hex_string

# Cartes
GOOGLE_MAPS_API_KEY=

# CORS
FRONTEND_URL=http://localhost:3000
